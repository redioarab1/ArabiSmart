# ==========================================
# ArabiSmart News - متغيرات بيئة Hetzner
# انسخ هذا الملف إلى .env وعدّل القيم
# ==========================================

# ─── قاعدة البيانات ───────────────────────────────────────────────────────────
MYSQL_ROOT_PASSWORD=ضع_كلمة_سر_قوية_هنا
MYSQL_USER=arabismart_user
MYSQL_PASSWORD=ضع_كلمة_سر_قوية_هنا
DATABASE_URL=mysql://arabismart_user:ضع_كلمة_سر_قوية_هنا@mysql:3306/arabismart

# ─── تخزين الملفات MinIO ──────────────────────────────────────────────────────
S3_ENDPOINT=http://minio:9000
S3_BUCKET=arabismart
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=ضع_كلمة_سر_قوية_هنا
S3_PUBLIC_URL=https://arabismart.vip/files
S3_REGION=us-east-1

# ─── المصادقة JWT ─────────────────────────────────────────────────────────────
# استخدم: openssl rand -base64 64
JWT_SECRET=ضع_سلسلة_عشوائية_طويلة_64_حرف_على_الأقل

# ─── الذكاء الاصطناعي (OpenAI) ────────────────────────────────────────────────
# احصل على مفتاح من: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-...
OPENAI_MODEL=gpt-4o-mini

# ─── البريد الإلكتروني (لاستعادة كلمة السر) ──────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@gmail.com
# استخدم App Password من Google: https://myaccount.google.com/apppasswords
SMTP_PASS=xxxx-xxxx-xxxx-xxxx

# ─── الموقع ───────────────────────────────────────────────────────────────────
FRONTEND_URL=https://arabismart.vip
SITE_URL=https://arabismart.vip
NODE_ENV=production
PORT=3000
TZ=Europe/Stockholm

# ─── Google Analytics ─────────────────────────────────────────────────────────
VITE_GA_MEASUREMENT_ID=G-Q9N7SX7GD5

# ─── النشر الاجتماعي (اختياري - أضف لاحقاً) ──────────────────────────────────
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHANNEL_ID=
# FACEBOOK_PAGE_TOKEN=
# FACEBOOK_PAGE_ID=
